# Existing PostgreSQL service is provided by Consultation-Booking-System/infra/docker-compose.db.yml.
DB_URL=jdbc:postgresql://pingan-care-postgres:5432/pingan_mobile_app
DB_USER=pingan_user
DB_PASSWORD=SamplePassword@123

POSTGRES_HOST=pingan-care-postgres
POSTGRES_PORT=5432
POSTGRES_DB=pingan_mobile_app
POSTGRES_USER=pingan_user
POSTGRES_PASSWORD=SamplePassword@123
DB_NETWORK_NAME=pingan-db-net
# One-shot admin seed tool. Override these before running in production.
APP_SEED_ADMIN_EMAIL=sample@admin.com
APP_SEED_ADMIN_PASSWORD=12345678
APP_SEED_ADMIN_FIRST_NAME=John
APP_SEED_ADMIN_LAST_NAME=Doe
APP_SEED_ADMIN_RESET_PASSWORD=false

# SMTP for transactional email (password reset + registration verification codes).
# Gmail address + app password; consumed by application.properties spring.mail.username/password.
# Without these, /auth/reset-password and /auth/send-verification-code cannot send mail.
MAIL_USERNAME=your-mail@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# JWT signing key (base64-encoded 256-bit). MUST be set to a strong secret in production.
# If unset, the app falls back to a built-in default (fine for dev; rotating in prod
# invalidates all existing access/refresh tokens, so users must log in again).
JWT_SECRET=

# Extra browser origins allowed by CORS, comma-separated (in addition to the built-in
# dev/list). Set this to the deployed web app origin(s), e.g.:
# APP_CORS_ORIGINS=https://rn-app.pingan.org.sg,https://www.pingan.org.sg
APP_CORS_ORIGINS=

# And relative secrets like OSS, as we do not read backend/.env in production
