# Existing PostgreSQL service is provided by Consultation-Booking-System/infra/docker-compose.db.yml.
DB_URL=jdbc:postgresql://pingan-care-postgres:5432/pingan_mobile_app
DB_USER=pingan_user
DB_PASSWORD=SamplePassword@123

POSTGRES_HOST=pingan-care-postgres
POSTGRES_PORT=5432
POSTGRES_DB=pingan_mobile_app
POSTGRES_USER=pingan_user
POSTGRES_PASSWORD=SamplePassword@123
DB_NETWORK_NAME=pingan-db-net
# One-shot admin seed tool. Override these before running in production.
APP_SEED_ADMIN_EMAIL=sample@admin.com
APP_SEED_ADMIN_PASSWORD=12345678
APP_SEED_ADMIN_FIRST_NAME=John
APP_SEED_ADMIN_LAST_NAME=Doe
APP_SEED_ADMIN_RESET_PASSWORD=false

# And relative secrets like OSS, as we do not read backend/.env in production
