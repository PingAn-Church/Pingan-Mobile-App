# Preferred: set the full backend origin that the app should call.
# Examples:
# BACKEND_BASE_URL=https://api.example.com
# BACKEND_BASE_URL=http://192.168.10.24:8080
BACKEND_BASE_URL=<your-backend-origin>

# Legacy local-dev fallback. Used only when BACKEND_BASE_URL is not set.
IP_ADDR=<your-local-ip-addr>

# Set to true only when LibreTranslate is up and serving through the backend.
ENABLE_LIBRE_TRANSLATE=false
