{
  "cli": {
    "version": ">= 16.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./secrets/google-service-account.json",
        "track": "internal"
      },
      "ios": {
        "ascAppId": "${ASC_APP_ID}",
        "ascApiKeyPath": "./secrets/AuthKey.p8",
        "ascApiKeyId": "${ASC_API_KEY_ID}",
        "ascApiKeyIssuerId": "${ASC_API_KEY_ISSUER_ID}"
      }
    }
  }
}
