        "DISTRIBUTION_CHANNEL": "direct"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "BACKEND_BASE_URL": "https://api.rn-app.pingan.org.sg",
        "ENABLE_LIBRE_TRANSLATE": "false",
        "DISTRIBUTION_CHANNEL": "direct"
      }
    },
    "production": {
      "env": {
        "BACKEND_BASE_URL": "https://api.rn-app.pingan.org.sg",
        "ENABLE_LIBRE_TRANSLATE": "false",
        "DISTRIBUTION_CHANNEL": "play"
