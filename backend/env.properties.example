# Copy to env.properties and fill in real values. env.properties is gitignored.

DB_URL=jdbc:postgresql://localhost:5432/pingan_mobile_app
DB_USER=your-db-user
DB_PASSWORD=your-db-password
IP_ADDR=0.0.0.0

# Password-reset email account (Gmail app password)
MAIL_USERNAME=your-mail@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# For Docker Compose, values are loaded from infra/.env and override these defaults.
