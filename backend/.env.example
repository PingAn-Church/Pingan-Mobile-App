ALIBABA_OSS_ENDPOINT=https://oss-ap-southeast-1.aliyuncs.com
# Optional: same-region internal endpoint for server-side OSS traffic (free bandwidth).
# Only resolvable from inside Alibaba Cloud (e.g. ECS); leave unset for local dev to
# fall back to the public endpoint above.
ALIBABA_OSS_INTERNAL_ENDPOINT=https://oss-ap-southeast-1-internal.aliyuncs.com
ALIBABA_OSS_ACCESS_KEY_ID=your-secrets
ALIBABA_OSS_ACCESS_KEY_SECRET=your-secrets
ALIBABA_OSS_BUCKET_NAME=your-oss-bucket-name
ALIBABA_OSS_REGION=ap-southeast-1
# Secret signing the temporary /media gateway URLs (any random string, >=32 chars
# recommended). Optional: falls back to JWT_SECRET, then to the built-in dev default.
# Rotating it invalidates outstanding media URLs (clients re-resolve within minutes).
MEDIA_TOKEN_SECRET=your-secrets
